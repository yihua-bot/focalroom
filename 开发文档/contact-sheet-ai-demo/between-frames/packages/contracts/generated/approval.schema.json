{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "expected_proposal_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "accepted_operation_ids": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    },
    "approval_nonce": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    }
  },
  "required": [
    "version",
    "workspace_id",
    "project_id",
    "expected_revision",
    "proposal_id",
    "expected_proposal_revision",
    "accepted_operation_ids",
    "approval_nonce"
  ],
  "additionalProperties": false
}
