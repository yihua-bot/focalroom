{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "AI 暂未开放": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 暂未开放"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI service is not available yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIサービスは現在利用できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 서비스를 아직 이용할 수 없습니다"
          }
        }
      }
    },
    "App 内购暂不可用（产品尚未登记）。": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 内购暂不可用（产品尚未登记）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In-app purchases are unavailable (products not yet registered)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内課金は現在利用できません（製品未登録）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인앱 구매를 아직 이용할 수 없습니다(상품 미등록)."
          }
        }
      }
    },
    "iPhone 开发预览": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 开发预览"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone dev preview"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 開発プレビュー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 개발 프리뷰"
          }
        }
      }
    },
    "← 排除   ↑ 待选   保留 →": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "← 排除   ↑ 待选   保留 →"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "← Reject   ↑ Undecided   Keep →"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "← 除外   ↑ 未定   採用 →"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "← 기각   ↑ 미정   채택 →"
          }
        }
      }
    },
    "一起整理线索、讨论选片和顺序。需要看图时，点下方 + 添加照片。": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一起整理线索、讨论选片和顺序。需要看图时，点下方 + 添加照片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize ideas, discuss selections and order together. Tap + below to add photos when needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒に手がかりを整理し、選択と順序を話し合います。画像が必要な場合は下の + で写真を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "함께 흐름을 정리하고 선택과 순서를 논의하세요. 이미지가 필요하면 아래 + 로 사진을 추가하세요."
          }
        }
      }
    },
    "上一张": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一张"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前へ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 사진"
          }
        }
      }
    },
    "上次移动结果待确认，核对前暂停编辑。": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次移动结果待确认，核对前暂停编辑。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last move is unconfirmed; editing paused until verified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の移動結果は未確認のため、確認まで編集を一時停止しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 이동 결과가 미확인이라 확인 전까지 편집이 일시정지되었습니다."
          }
        }
      }
    },
    "不登录也可浏览与导出这台 iPhone 上已保存的本机原片。": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不登录也可浏览与导出这台 iPhone 上已保存的本机原片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse and export originals saved on this iPhone without signing in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインしなくても、この iPhone に保存された原本を閲覧・書き出しできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 없이도 이 iPhone에 저장된 원본을 열람하고 내보낼 수 있습니다."
          }
        }
      }
    },
    "云端项目已是权威版本；本机保留原片与预览作为离线存档，选片请在云端项目进行。": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端项目已是权威版本；本机保留原片与预览作为离线存档，选片请在云端项目进行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud project is now authoritative; originals and previews remain here as an offline archive. Please select in the cloud project."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドプロジェクトが正式版です。本体には原本とプレビューがオフライン用に残ります。選択はクラウド側で行ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 프로젝트가 공식 버전입니다. 기기에는 원본과 미리보기가 오프라인 보관용으로 남습니다. 선별은 클라우드에서 진행하세요."
          }
        }
      }
    },
    "交换照片": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交换照片"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap photos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を入れ替え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 교체"
          }
        }
      }
    },
    "仅本机": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅本机"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this iPhone only"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneのみ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에만"
          }
        }
      }
    },
    "从一张照片，\\n开始对话。": {
      "localizationState": "new",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从一张照片，\\n开始对话。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "从一张照片，\\n开始对话。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "从一张照片，\\n开始对话。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "从一张照片，\\n开始对话。"
          }
        }
      }
    },
    "从右上角添加照片或便签开始布局": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右上角添加照片或便签开始布局"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add photos or notes from the top-right to start your layout"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から写真やメモを追加してレイアウトをはじめます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 위에서 사진이나 메모를 추가해 레이아웃을 시작하세요"
          }
        }
      }
    },
    "从文件导入": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从文件导入"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import from Files"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルから読み込む"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에서 가져오기"
          }
        }
      }
    },
    "从相册导入": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从相册导入"
