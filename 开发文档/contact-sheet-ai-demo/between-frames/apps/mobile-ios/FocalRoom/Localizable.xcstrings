          }
        }
      }
    },
    "AI 服务状态读取失败，请点按状态栏重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load AI service status; tap the status bar to retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIサービス状態の取得に失敗しました。ステータスバーをタップして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 서비스 상태 조회에 실패했습니다. 상태 표시줄을 탭하여 재시도해 주세요."
          }
        }
      }
    },
    "AI 返回的内容无法读取": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI response can't be read"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIの返答を読み取れません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 응답을 읽을 수 없음"
          }
        }
      }
    },
    "App Store 暂未返回产品，请稍后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store hasn't returned products yet; please try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeから製品がまだ返されていないため、しばらくしてから再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 상품을 아직 불러오지 못했습니다. 잠시 후 다시 시도해 주세요."
          }
        }
      }
    },
