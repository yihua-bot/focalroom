        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の許可が失効しました。写真を再選択して確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 승인 기간이 만료되었습니다. 사진을 다시 선택하고 확인해 주세요."
          }
        }
      }
    },
    "照片查看区。左滑排除，右滑保留，上滑待选；放大后可拖动查看细节": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo viewer. Swipe left to reject, right to keep, up to mark undecided; drag when zoomed to inspect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真表示エリア。左スワイプで除外、右で採用、上で未定。拡大時はドラッグで詳細確認。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 뷰어. 왼쪽 스와이프 기각, 오른쪽 채택, 위로 미정. 확대 시 드래그로 세부 확인."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片查看区。左滑排除，右滑保留，上滑待选；放大后可拖动查看细节"
          }
        }
      }
    },
