          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 라이브러리에서 프로젝트를 한 번 연 후 돌아오세요."
          }
        }
      }
    },
    "请先在相册导入照片，再添加到画布。": {
      "extractionState": "manual",
      "localizationState": "translated",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import photos from your library before adding them to the canvas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムから写真を取り込んでからキャンバスに追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범에서 사진을 가져온 뒤 캔버스에 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在相册导入照片，再添加到画布。"
          }
        }
      }
    },
    "请先确认 AI 服务已开放、邮箱已验证且账户额度可用，再发送消息。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before sending, confirm the AI service is available, your email is verified, and your account has credits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信前に、AIサービスが利用可能か、メールが認証済みか、アカウントの残高があるかを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기 전 AI 서비스 이용 가능 여부, 이메일 인증 여부, 계정 크레딧 잔여를 확인하세요."
          }
        }
      }
    },
    "请先等待或取消正在进行的 AI 任务。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for or cancel the AI task in progress first."
