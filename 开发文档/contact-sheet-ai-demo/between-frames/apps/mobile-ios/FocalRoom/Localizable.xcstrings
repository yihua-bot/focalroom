          }
        }
      }
    },
    "购买与恢复经 App Store 处理；权益解锁以服务端核验为准。": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买与恢复经 App Store 处理；权益解锁以服务端核验为准。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases and restores go through the App Store; entitlements unlock after server verification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入と復元はApp Store経由で処理され、権限はサーバー検証後に有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매와 복원은 App Store를 통해 처리되며, 권한은 서버 검증 후 활성화됩니다."
          }
        }
      }
    },
    "转写在本机完成，音频不会上传。需要 iOS 26 与中文语音资源。": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写在本机完成，音频不会上传。需要 iOS 26 与中文语音资源。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription happens on device; audio is never uploaded. Requires iOS 26 and Chinese voice resources."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしは端末内で行われ、音声はアップロードされません。iOS 26 と中国語音声リソースが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사는 기기에서 처리되며 오디오는 업로드되지 않습니다. iOS 26과 중국어 음성 리소스가 필요합니다."
          }
        }
      }
    },
