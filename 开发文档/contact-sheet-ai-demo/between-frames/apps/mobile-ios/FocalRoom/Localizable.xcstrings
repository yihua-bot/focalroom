    "离线只读：原片与记录可浏览、可导出；导入与选片请登录后操作": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线只读：原片与记录可浏览、可导出；导入与选片请登录后操作"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline read-only: browse and export originals and records; sign in to import or select"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン読み取り専用：原本と記録の閲覧・書き出し可。読み込みと選択はログインしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 읽기 전용: 원본과 기록 열람·내보내기 가능. 가져오기와 선별은 로그인 후 이용하세요"
          }
        }
      }
    },
    "离线时仅显示已缓存的项目，画布与分析任务需联网。": {
      "localizationState": "translated",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线时仅显示已缓存的项目，画布与分析任务需联网。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only cached projects show offline; canvas and analysis need a connection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインではキャッシュ済みプロジェクトのみ表示されます。キャンバスと分析はネット接続が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인에서는 캐시된 프로젝트만 표시됩니다. 캔버스와 분석은 네트워크가 필요합니다."
          }
        }
      }
    },
