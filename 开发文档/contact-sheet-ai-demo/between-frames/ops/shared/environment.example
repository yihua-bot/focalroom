# 在仓库外保存真实配置；密码使用 URL 安全随机值，避免连接串转义歧义。
FOCALROOM_DB_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
FOCALROOM_WEB_ORIGIN=http://127.0.0.1:8084
FOCALROOM_APP_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_APP_PASSWORD
FOCALROOM_MIGRATOR_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_MIGRATOR_PASSWORD
# 邮件密钥保存在仓库外；缺失时验证码请求返回 EMAIL_UNAVAILABLE。
FOCALROOM_RESEND_API_KEY=
# 使用已在邮件服务验证的发件域，不能直接使用此示例地址上线。
FOCALROOM_EMAIL_FROM=FocalRoom <noreply@example.com>
# Google 登录（可选）：与前端构建时 VITE_FOCALROOM_GOOGLE_CLIENT_ID 同值。
FOCALROOM_GOOGLE_CLIENT_ID=
# 订阅保持关闭，待确定商户、正式价格、额度和账务政策后启用。
# 真实支付凭据仅保存在服务器配置中，不能写入仓库或客户端。
FOCALROOM_BILLING_ENABLED=0
FOCALROOM_STRIPE_SECRET_KEY=
FOCALROOM_STRIPE_WEBHOOK_SECRET=
FOCALROOM_BILLING_PRICES=[]
