{
  "version": "2.0",
  "schema_note": "Application-owned logical tool descriptors, not a specific LLM vendor's wire schema. Policies are enforced outside prompt and model outputs.",
  "permission_levels": ["READ", "VISION", "MEMORY", "COLLAB_READ", "DRAFT_WRITE", "INTERACT", "CONTROL"],
  "tools": [
    {"name":"get_project_context","permission":"READ","parameters":{"type":"object","additionalProperties":false,"required":["project_id"],"properties":{"project_id":{"type":"string"}}}},
    {"name":"list_photos","permission":"READ","parameters":{"type":"object","additionalProperties":false,"required":["project_id","page_size"],"properties":{"project_id":{"type":"string"},"filter":{"type":"string"},"page_size":{"type":"integer","minimum":1,"maximum":100},"cursor":{"type":["string","null"]}}}},
    {"name":"search_photos","permission":"READ","parameters":{"type":"object","additionalProperties":false,"required":["project_id","query"],"properties":{"project_id":{"type":"string"},"query":{"type":"string","maxLength":300},"max_results":{"type":"integer","minimum":1,"maximum":100}}}},
    {"name":"inspect_photos","permission":"VISION","parameters":{"type":"object","additionalProperties":false,"required":["project_id","photo_ids","questions"],"properties":{"project_id":{"type":"string"},"photo_ids":{"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"type":"string"}},"questions":{"type":"array","minItems":1,"maxItems":5,"items":{"type":"string"}}}}},
    {"name":"compare_photos","permission":"VISION","parameters":{"type":"object","additionalProperties":false,"required":["project_id","photo_ids","editing_goal"],"properties":{"project_id":{"type":"string"},"photo_ids":{"type":"array","minItems":2,"maxItems":8,"uniqueItems":true,"items":{"type":"string"}},"editing_goal":{"type":"string"}}}},
    {"name":"get_sequence","permission":"READ","parameters":{"type":"object","additionalProperties":false,"required":["project_id","revision"],"properties":{"project_id":{"type":"string"},"revision":{"type":"integer","minimum":0}}}},
    {"name":"retrieve_memory","permission":"MEMORY","parameters":{"type":"object","additionalProperties":false,"required":["project_id","query"],"properties":{"project_id":{"type":"string"},"query":{"type":"string"},"max_items":{"type":"integer","minimum":1,"maximum":15}}}},
    {"name":"get_comments","permission":"COLLAB_READ","parameters":{"type":"object","additionalProperties":false,"required":["project_id"],"properties":{"project_id":{"type":"string"},"thread_ids":{"type":"array","items":{"type":"string"}}}}},
    {"name":"create_edit_proposal","permission":"DRAFT_WRITE","parameters":{"type":"object","additionalProperties":false,"required":["project_id","base_revision","operations","title"],"properties":{"project_id":{"type":"string"},"base_revision":{"type":"integer","minimum":0},"title":{"type":"string","maxLength":200},"operations":{"type":"array","minItems":1,"maxItems":200,"items":{"type":"object","additionalProperties":false,"required":["op","photo_id"],"properties":{"op":{"type":"string","enum":["add","remove","move"]},"photo_id":{"type":"string"},"to_index":{"type":"integer","minimum":0},"reason":{"type":"string","maxLength":1000}}}}}}},
    {"name":"revise_edit_proposal","permission":"DRAFT_WRITE","parameters":{"type":"object","additionalProperties":false,"required":["proposal_id","operations"],"properties":{"proposal_id":{"type":"string"},"operations":{"type":"array","maxItems":200,"items":{"type":"object"}}}}},
    {"name":"evaluate_sequence","permission":"READ","parameters":{"type":"object","additionalProperties":false,"required":["project_id","sequence_or_proposal_id","criteria"],"properties":{"project_id":{"type":"string"},"sequence_or_proposal_id":{"type":"string"},"criteria":{"type":"array","items":{"type":"string"}}}}},
    {"name":"summarize_review_disagreement","permission":"COLLAB_READ","parameters":{"type":"object","additionalProperties":false,"required":["project_id","thread_ids"],"properties":{"project_id":{"type":"string"},"thread_ids":{"type":"array","minItems":2,"items":{"type":"string"}}}}},
    {"name":"request_feedback","permission":"INTERACT","parameters":{"type":"object","additionalProperties":false,"required":["question"],"properties":{"question":{"type":"string","maxLength":700},"options":{"type":"array","maxItems":5,"items":{"type":"string"}}}}},
    {"name":"finish_task","permission":"CONTROL","parameters":{"type":"object","additionalProperties":false,"required":["result_kind","object_ids"],"properties":{"result_kind":{"type":"string","enum":["proposal","analysis","needs_user"]},"object_ids":{"type":"array","items":{"type":"string"}},"summary":{"type":"string"}}}}
  ],
  "policy": {
    "forbid_model_direct_commands": ["proposal.apply", "photo.delete_original", "workspace.invite", "payment.refund", "service.payout", "project.publish"],
    "require_photo_scope_validation": true,
    "require_consent_before_remote_vision": true,
    "default_agent_write_domain": "draft_only",
    "max_tool_invocations_per_task": 48
  }
}
